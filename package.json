{
  "name": "nexfem",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @nexfem/desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @nexfem/e2e e2e",
    "tauri": "pnpm --filter @nexfem/desktop tauri",
    "gen": "pnpm --filter @nexfem/model-core gen"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
