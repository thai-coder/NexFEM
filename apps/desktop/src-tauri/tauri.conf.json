{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexFEM",
  "version": "0.1.0",
  "identifier": "io.github.thai-coder.nexfem",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexFEM",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "label": "main",
        "visible": false
      },
      {
        "label": "splash",
        "title": "NexFEM",
        "url": "splash.html",
        "width": 560,
        "height": 330,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "lkat.vn",
    "category": "Productivity",
    "shortDescription": "NexFEM - Structural Analysis Application",
    "longDescription": "NexFEM - structural analysis and design software for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "template": "installer/installer.nsi"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "fragmentPaths": ["installer/nxf-icon.wxs"],
        "componentRefs": ["NxfDefaultIcon"]
      }
    },
    "copyright": "Copyright (c) lkat.vn. All rights reserved.",
    "fileAssociations": [
      {
        "ext": [
          "nxf"
        ],
        "name": "NexFEM.Project",
        "description": "NexFEM Project",
        "role": "Editor",
        "mimeType": "application/x-nexfem-project"
      }
    ]
  },
  "mainBinaryName": "NexFEM"
}
