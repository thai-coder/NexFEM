$ File: synthetic ETABS importer test, not exported from ETABS
$ PROGRAM INFORMATION
  PROGRAM "ETABS" VERSION "23.2.0"
$ CONTROLS
  UNITS "KN" "M" "C"
  PREFERENCE MERGETOL 0.001
$ STORIES - IN SEQUENCE FROM TOP
  STORY "S1" HEIGHT 4
  STORY "Base" ELEV 0
$ MATERIAL PROPERTIES
  MATERIAL "C30" TYPE "Concrete" WEIGHTPERVOLUME 25
  MATERIAL "C30" SYMTYPE "Isotropic" E 30000000 U 0.2
$ FRAME SECTIONS
  FRAMESECTION "C400" MATERIAL "C30" SHAPE "Concrete Rectangular" D 0.4 B 0.4
$ POINT COORDINATES
  POINT "A" 0 0
  POINT "B" 6 0
  POINT "M" 3 0
$ LINE CONNECTIVITIES
  LINE "B1" BEAM "A" "B" 0
$ POINT ASSIGNS
  POINTASSIGN "A" "S1" RESTRAINT "UX UY UZ RX RY RZ"
$ LINE ASSIGNS
  LINEASSIGN "B1" "S1" SECTION "C400" AUTOMESH "YES"
$ LOAD PATTERNS
  LOADPATTERN "MOMENT" TYPE "Dead" SELFWEIGHT 0
$ POINT OBJECT LOADS
  POINTLOAD "M" "S1" TYPE "FORCE" LC "MOMENT" MY 12
$ LOAD CASES
  LOADCASE "MOMENT" TYPE "Linear Static" LOADPAT "MOMENT" SF 1
$ END OF MODEL FILE
